# Copy to .env

# Required
DATABASE_URL=postgresql://metadata:metadata@localhost:5432/metadata?schema=public
REDIS_URL=redis://localhost:6379

# Conflux
CONFLUX_RPC_URL=https://evmtestnet.confluxrpc.com
REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# IPFS: use Pinata
PINATA_JWT=your_pinata_jwt
PINATA_GATEWAY=https://gateway.pinata.cloud

# Moderation & notifications
MODERATOR_WALLET=0x0000000000000000000000000000000000000000
WEBHOOK_URL=

# Validation (spec: <50KB metadata, allowed logo MIME)
MAX_METADATA_KB=50
ALLOWED_LOGO_MIME=image/png,image/jpeg,image/svg+xml

# Rate limiting (per wallet and per IP)
MAX_SUBMISSIONS_PER_WALLET_PER_MIN=10

# Optional
PORT=3000
CONFLUXSCAN_API_URL=
CONFLUXSCAN_API_KEY=
