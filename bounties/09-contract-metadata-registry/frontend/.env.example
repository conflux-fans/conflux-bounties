# Conflux Contract Metadata Registry – Frontend
# Copy to .env.local (Next.js) or .env

NEXT_PUBLIC_API_URL=http://localhost:3000/v1
NEXT_PUBLIC_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
# Optional: block registry implementation address in "Contract address" (avoids contract error when user pastes it)
# NEXT_PUBLIC_REGISTRY_IMPLEMENTATION_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_CONFLUX_RPC_URL=https://evmtestnet.confluxrpc.com

# Optional: IPFS gateway for metadata/logo resolution (default: Pinata)
# NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud
