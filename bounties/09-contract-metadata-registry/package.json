{
  "name": "conflux-metadata-registry",
  "private": true,
  "workspaces": [
    "contracts",
    "backend",
    "frontend",
    "shared",
    "sdk"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "lint": "npm run build -w @conflux-metadata/shared && npm run lint --workspaces --if-present",
    "clean:modules": "rm -rf node_modules package-lock.json */node_modules */package-lock.json"
  },
  "dependencies": {
    "@pinojs/redact": "^0.4.0",
    "@swc/helpers": "^0.5.5",
    "atomic-sleep": "^1.0.0",
    "esbuild": "^0.27.3",
    "forwarded": "^0.2.0",
    "ipaddr.js": "^2.3.0"
  },
  "devDependencies": {
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@vitest/coverage-istanbul": "^4.0.18",
    "bytes": "^3.1.2",
    "http-errors": "^2.0.1",
    "is-number": "^7.0.0",
    "jsdom": "^24.1.3",
    "napi-postinstall": "^0.3.4",
    "prisma": "^5.22.0",
    "vitest": "^4.0.18"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.6.1"
  }
}