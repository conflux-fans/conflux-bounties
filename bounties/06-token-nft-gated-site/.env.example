# Conflux RPC
NEXT_PUBLIC_CONFLUX_RPC_URL=https://evm.confluxrpc.com
NEXT_PUBLIC_CONFLUX_TESTNET_RPC_URL=https://evmtestnet.confluxrpc.com

# Database (Postgres)
DATABASE_URL=postgresql://postgres:password@localhost:5432/gated_site

# Redis (for rate limiting)
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Session
SESSION_SECRET=change-me-to-a-random-32-char-string

# Supabase (for file storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=gated-files

# SIWC
NEXT_PUBLIC_SIWC_DOMAIN=localhost

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# CAPTCHA (optional)
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# Wallet Connect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WC_PROJECT_ID=

# Default gating rules (JSON array, loaded on first seed)
DEFAULT_RULES_JSON=[{"name":"Demo ERC20 Rule","contractAddress":"0x0000000000000000000000000000000000000000","contractType":"ERC20","minBalance":"1000","chainId":1030}]
