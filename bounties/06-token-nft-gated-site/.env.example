# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gated?schema=public"

# Session signing (min 32 chars)
SESSION_SECRET="change-me-use-at-least-thirty-two-characters!!"

# SIWE message domain — must match what users sign (see NEXT_PUBLIC_)
SIWC_DOMAIN="localhost"
NEXT_PUBLIC_SIWC_DOMAIN="localhost"

# Comma-separated admin wallets (lowercase ok) — required to open /admin
ADMIN_WALLETS="0x0000000000000000000000000000000000000000"

# Conflux eSpace RPC (optional; defaults shown in src/lib/chains.ts)
# CONFLUX_RPC_URL="https://evm.confluxrpc.com"
# CONFLUX_TESTNET_RPC_URL="https://evmtestnet.confluxrpc.com"

# Redis for rate limits (optional — falls back to in-memory)
# REDIS_URL="redis://localhost:6379"

# hCaptcha / similar — set both to enforce on login
# CAPTCHA_SECRET=""
# CAPTCHA_SITE_KEY=""

# Rate limit (login + nonce)
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_WINDOW_SEC=60

# Session cookie lifetime (days)
# SESSION_MAX_DAYS=7

# Public site URL (used in signed download links from POST /api/assets/issue)
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional separate secret for HMAC download tokens (falls back to SESSION_SECRET)
# ASSET_SIGNING_SECRET="another-32-char-minimum-secret-string-here!!"

# Signed download link lifetime (seconds)
# ASSET_URL_TTL_SEC=300

# Optional: POST JSON payloads on auth failures (Slack, Discord webhook, etc.)
# ABUSE_WEBHOOK_URL="https://example.com/hooks/..."

# Optional: bootstrap seed rules — JSON object { "conditions": [ ... ] } for all default paths
# DEFAULT_RULES_JSON="{\"conditions\":[{\"type\":\"ERC20\",\"chainId\":1030,\"address\":\"0x...\",\"minBalance\":\"0\"}]}"

# --- Gated files: Cloudflare R2 (recommended) — S3-compatible API ---
# Local dev: omit remote block or use STORAGE_MODE=local (files in ./storage/gated).
#
# In Cloudflare: R2 → Create bucket → Manage R2 API Tokens (S3-compatible keys).
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#
# STORAGE_MODE="local"
# STORAGE_MODE="r2"
#
# R2_BUCKET="your-bucket-name"
# R2_ENDPOINT="https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.cloudflarestorage.com"
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_REGION="auto"
# R2_FORCE_PATH_STYLE="true"
#
# Legacy alias (same SDK): S3_BUCKET, S3_ENDPOINT, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_REGION, S3_FORCE_PATH_STYLE

# --- Periodic token metadata refresh (cron / worker) ---
# Protects GET/POST /api/cron/metadata-refresh — same logic as Admin → refresh metadata.
# CRON_SECRET="use-a-long-random-string-at-least-16-chars"
# CRON_BASE_URL="http://localhost:3000"
