{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(x402_http_requests_total[5m])",
          "legendFormat": "{{method}} {{path}} ({{status}})"
        }
      ]
    },
    {
      "title": "Payment Settlements",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(x402_payments_total[5m])",
          "legendFormat": "{{endpoint}} ({{status}})"
        }
      ]
    },
    {
      "title": "Total Revenue (USDT0)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(x402_payment_amount_total) / 1000000"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "displayName": "USDT0"
        }
      }
    },
    {
      "title": "Invoices Created",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "sum(x402_invoices_created_total)"
        }
      ]
    },
    {
      "title": "Gas Saved (Pre-validation Rejections)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(x402_facilitator_gas_saved_total)"
        }
      ]
    },
    {
      "title": "Payments by Status",
      "type": "piechart",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "targets": [
        {
          "expr": "sum by (status) (x402_payments_total)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "title": "Request Latency (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(x402_http_request_duration_ms_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(x402_http_request_duration_ms_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(x402_http_request_duration_ms_bucket[5m]))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["x402", "payments"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "x402 Payment Dashboard",
  "uid": "x402-dashboard"
}
