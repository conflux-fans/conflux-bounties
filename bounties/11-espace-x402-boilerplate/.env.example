# ═══════════════════════════════════════════════════════════════════
# x402 Full-Stack Boilerplate — Environment Variables
#
# SETUP:
#   1. Copy this file to .env:        cp .env.example .env
#   2. Generate wallets (Step 3 in README)
#   3. Fund facilitator wallet with testnet CFX from https://efaucet.confluxnetwork.org/
#   4. Deploy contracts:              npm run contracts:deploy
#   5. Paste deployed addresses below
#   6. Start dev mode:                npm run dev:api:local
#
# For dev mode (npm run dev:api:local), only the "Required" section
# is needed. Everything else has sensible defaults.
# ═══════════════════════════════════════════════════════════════════

# npm run dev:api:local & npm run dev:web &  npm run dev:agent

# ── Required ──────────────────────────────────────────────────────

# Network: "testnet" (default) or "mainnet"
NETWORK=testnet

# Default chain ID — fallback when requests don't include an x-chain-id header.
# The frontend always sends x-chain-id when switching networks, so this only
# affects direct API calls (curl, agent, etc.) that omit the header.
# 71 = testnet (default), 1030 = mainnet
# CHAIN_ID=71

# Deployed contract addresses (output from: npm run contracts:deploy)
# Legacy fallback — used when per-network vars below are not set
X402_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
USDT0_ADDRESS=0x0000000000000000000000000000000000000000

# Per-network contract addresses (recommended for multi-network support)
# Testnet (chain 71) — set these to your deployed testnet contracts
X402_CONTRACT_ADDRESS_TESTNET=0x0000000000000000000000000000000000000000
USDT0_ADDRESS_TESTNET=0x0000000000000000000000000000000000000000
# Mainnet (chain 1030) — real token addresses
X402_CONTRACT_ADDRESS_MAINNET=0x0000000000000000000000000000000000000000
USDT0_ADDRESS_MAINNET=0xaf37e8b6c9ed7f6318979f56fc287d76c30847ff
# CNHT0 (AxCNH) on mainnet — additional ERC-3009 payment token
CNHT0_ADDRESS=0x70bfd7f7eadf9b9827541272589a6b2bb760ae2e

# Service wallet (facilitator) — pays gas to settle ERC-3009 authorizations on-chain
# Generate a new wallet:
#   npx tsx -e "import {generatePrivateKey, privateKeyToAccount} from 'viem/accounts'; const k = generatePrivateKey(); console.log('KEY:', k, '\nADDRESS:', privateKeyToAccount(k).address)"
SERVICE_WALLET_KEY=0x_your_private_key_here
SERVICE_WALLET_ADDRESS=0x_your_address_here


# ── Conflux eSpace Network ───────────────────────────────────────

# Override RPC if needed; defaults are auto-selected based on NETWORK.
# Testnet: https://evmtestnet.confluxrpc.com (chain 71)
# Mainnet: https://evm.confluxrpc.com (chain 1030)
# CONFLUX_RPC_URL=https://evmtestnet.confluxrpc.com


# ── Seller API ────────────────────────────────────────────────────

API_PORT=4000

# Admin API key — for programmatic/CI access to /admin/* routes only.
# The admin dashboard authenticates via wallet signature (no shared secret needed).
# Generate: node -e "console.log(crypto.randomUUID())"
# Leave empty if you only use the wallet-based admin dashboard.
ADMIN_API_KEY=


# ── Database & Redis (optional — only for production mode) ───────

# Dev mode (npm run dev:api:local) uses in-memory storage. No DB required.
# Production mode (npm run dev:api) needs Postgres + Redis.
# Easiest way: docker compose up postgres redis
DATABASE_URL=postgresql://x402:x402pass@localhost:5432/x402_db
REDIS_URL=redis://localhost:6379


# ── Web Frontend ──────────────────────────────────────────────────

NEXT_PUBLIC_API_BASE=http://localhost:4000

# WalletConnect project ID — get one free at https://cloud.walletconnect.com/
# Frontend works without it, but wallet connection options will be limited.
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id

# Contract addresses for the frontend (same values as above)
NEXT_PUBLIC_USDT0_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_X402_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Per-network verifier addresses (used by wagmi config for network switching)
NEXT_PUBLIC_X402_CONTRACT_ADDRESS_TESTNET=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_X402_CONTRACT_ADDRESS_MAINNET=0x0000000000000000000000000000000000000000

# Service wallet address (shown in admin dashboard, used for wallet-based admin auth)
NEXT_PUBLIC_SERVICE_WALLET_ADDRESS=0x_your_address_here

# Network for the frontend wallet connection
NEXT_PUBLIC_NETWORK=testnet

# Faucet URL for testnet CFX
NEXT_PUBLIC_FAUCET_URL=https://efaucet.confluxnetwork.org/


# ── AI Agent (optional) ──────────────────────────────────────────

# Agent wallet private key (must be separate from service wallet)
# The agent uses this to sign ERC-3009 authorizations when paying for premium data.
AGENT_PRIVATE_KEY=0x_agent_private_key_here

# Spend cap in USDT0 smallest unit (6 decimals). 10_000_000 = 10 USDT0
AGENT_SPEND_CAP=10000000
# Daily budget in USDT0 smallest unit. 5_000_000 = 5 USDT0
AGENT_DAILY_BUDGET=5000000
# How often the agent polls for new tasks (ms)
AGENT_POLL_INTERVAL_MS=5000
# SQLite path for agent session/spend persistence
AGENT_DB_PATH=./agent-sessions.db


# ── LLM Provider (for AI agent) ──────────────────────────────────

# Any OpenAI-compatible provider works: OpenAI, Kimi/Moonshot, DeepSeek, etc.
# Examples:
#   OpenAI:     OPENAI_API_BASE=https://api.openai.com/v1       LLM_MODEL=gpt-4o-mini
#   Kimi:       OPENAI_API_BASE=https://api.moonshot.ai/v1      LLM_MODEL=kimi-k2-0905-preview
#   DeepSeek:   OPENAI_API_BASE=https://api.deepseek.com/v1     LLM_MODEL=deepseek-chat
OPENAI_API_KEY=sk-your_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini


# ── Observability (optional) ─────────────────────────────────────

LOG_LEVEL=info
# Slack/Discord webhook URL for alerting (leave empty to disable)
ALERT_WEBHOOK_URL=
